<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-indigo-50">
  <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6">
    <div class="flex items-center gap-2">
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-lg font-bold text-white">C</span>
      <span class="text-lg font-semibold tracking-tight text-gray-900"><%= t("views.home.index.brand") %></span>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to t("views.home.index.sign_in"), new_user_session_path,
            class: "rounded-lg px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-white/80" %>
      <%= link_to t("views.home.index.get_started"), new_user_registration_path,
            class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-6 pb-24 pt-12">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
        <%= t("views.home.index.hero_title") %>
      </h1>
      <p class="mt-6 text-lg leading-8 text-gray-600">
        <%= t("views.home.index.hero_subtitle") %>
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <%= link_to t("views.home.index.create_account"), new_user_registration_path,
              class: AuthHelper::BTN_PRIMARY_CLASS + " sm:w-auto sm:px-8" %>
        <%= link_to t("views.home.index.sign_in"), new_user_session_path, class: AuthHelper::BTN_SECONDARY_CLASS + " sm:w-auto sm:px-8" %>
      </div>
    </div>
  </main>
</div>
