<% if notice.present? %>
  <div class="mb-6 rounded-lg bg-green-50 px-4 py-3 text-sm text-green-800 ring-1 ring-green-200" role="status">
    <%= notice %>
  </div>
<% end %>

<% if alert.present? %>
  <div class="mb-6 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 ring-1 ring-red-200" role="alert">
    <%= alert %>
  </div>
<% end %>
