<header class="flex shrink-0 items-center justify-between border-b border-gray-200 bg-white px-4 py-3 sm:px-6"
        data-controller="notifications-live"
        data-notifications-live-unread-value="<%= unread_notifications_count %>">
  <%= link_to comments_path,
        class: "flex items-center gap-2 rounded-lg hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600",
        data: { turbo: false },
        title: t("views.shared.app_header.back_to_comments_title") do %>
    <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-600 text-sm font-bold text-white">C</span>
    <span class="text-base font-semibold text-gray-900"><%= t("views.shared.app_header.brand") %></span>
  <% end %>

  <div class="flex items-center gap-3">
    <span class="hidden text-sm text-gray-600 sm:inline"><%= current_user.display_name %></span>
    <%= link_to t("views.shared.app_header.people"), users_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
    <%= link_to notifications_path, class: "relative text-sm font-medium text-indigo-600 hover:text-indigo-500" do %>
      <%= t("views.shared.app_header.notifications") %>
      <% unread = unread_notifications_count %>
      <span data-notifications-live-target="badge"
            class="ml-1 inline-flex min-w-[1.25rem] items-center justify-center rounded-full bg-indigo-600 px-1.5 py-0.5 text-[10px] font-bold leading-none text-white <%= "hidden" unless unread.positive? %>">
        <%= badge_count(unread) if unread.positive? %>
      </span>
    <% end %>
    <%= button_to t("views.shared.app_header.sign_out"), destroy_user_session_path, method: :delete,
          data: { turbo: false },
          class: "rounded-lg px-3 py-1.5 text-sm font-medium text-gray-600 ring-1 ring-gray-200 hover:bg-gray-50" %>
  </div>
</header>
