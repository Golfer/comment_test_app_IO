<%# locals: comment, depth: 0, thread_reply_count: 0, thread_expanded: false, thread_open: false %>
<% depth = local_assigns.fetch(:depth, 0) %>
<% thread_reply_count = local_assigns.fetch(:thread_reply_count, 0) %>
<% thread_expanded = local_assigns.fetch(:thread_expanded, false) %>
<% thread_open = local_assigns.fetch(:thread_open, false) %>
<% is_feed_root = depth.zero? && !thread_expanded %>
<li id="<%= dom_id(comment) %>"
    class="rounded-xl bg-white p-4 shadow-sm ring-1 ring-gray-200 <%= "ring-2 ring-indigo-200" if is_feed_root && thread_open %>"
    style="margin-left: <%= depth * 1.25 %>rem"
    <% if is_feed_root %>
      data-controller="thread"
      data-thread-url-value="<%= replies_comment_path(comment) %>"
      data-thread-open-value="<%= thread_open %>"
      data-action="click->thread#open"
    <% end %>>
  <div class="flex items-start gap-2">
    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-xs font-semibold text-indigo-700">
      <%= comment.user.initials %>
    </span>
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <p class="text-sm font-medium text-gray-900"><%= comment.user.display_name %></p>
        <% if thread_reply_count.positive? %>
          <%= render "comments/thread_badge",
                comment: comment,
                thread_reply_count: thread_reply_count,
                compact: thread_expanded %>
        <% else %>
          <span id="<%= dom_id(comment, :thread_badge) %>" class="hidden" aria-hidden="true"></span>
        <% end %>
      </div>
      <p class="text-xs text-gray-500"><%= t("views.shared.time_ago", time: time_ago_in_words(comment.created_at)) %></p>
    </div>
  </div>

  <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-gray-700"><%= comment_body(comment) %></p>

  <div class="mt-3 flex flex-wrap items-center gap-3">
    <button type="button"
            class="text-xs font-medium text-indigo-600 hover:text-indigo-500"
            data-controller="reply-toggle"
            data-action="reply-toggle#toggle"
            data-reply-toggle-target-id-value="<%= dom_id(comment, :reply_form) %>">
      <%= t("views.comments.comment.reply_button") %>
    </button>
    <% if is_feed_root && thread_reply_count.positive? && !thread_open %>
      <button type="button"
              data-thread-open
              data-thread-target="openButton"
              class="text-xs font-medium text-indigo-700 underline-offset-2 hover:underline"
              data-action="click->thread#open">
        <%= t("views.comments.comment.open_thread", count: thread_reply_count) %>
      </button>
    <% end %>
  </div>

  <div id="<%= dom_id(comment, :reply_form) %>" class="mt-3 hidden">
    <%= render "comments/form", parent: comment %>
  </div>

  <% if is_feed_root %>
    <%= render "comments/thread_meta",
          comment: comment,
          thread_reply_count: thread_reply_count,
          thread_open: thread_open %>
    <%= turbo_frame_tag dom_id(comment, :replies),
          src: (thread_open ? replies_comment_path(comment) : nil),
          class: "block mt-3",
          data: { thread_target: "frame" } do %>
      <ul id="<%= dom_id(comment, :replies_list) %>" class="space-y-3"></ul>
    <% end %>
  <% end %>
</li>
