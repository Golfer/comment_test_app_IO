<%= render layout: "shared/app_page" do %>
  <div class="mb-6">
    <%= link_to users_path, class: "inline-flex items-center gap-1 text-sm font-medium text-indigo-600 hover:text-indigo-500" do %>
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
      </svg>
      <%= t("views.users.show.back_to_people") %>
    <% end %>

    <div class="mt-4 flex items-center gap-3">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-indigo-100 text-base font-semibold text-indigo-700">
        <%= @user.initials %>
      </span>
      <div>
        <h1 class="text-xl font-semibold text-gray-900"><%= @user.display_name %></h1>
        <p class="text-sm text-gray-500"><%= t("views.users.show.comments_count", count: @comments.size) %></p>
      </div>
    </div>
  </div>

  <% if @comments.empty? %>
    <%= render "shared/empty_state",
          message: t("views.users.show.empty_message", name: @user.display_name),
          action: link_to(t("views.users.show.back_to_comments"), comments_path, class: "inline-flex text-sm font-medium text-indigo-600 hover:text-indigo-500") %>
  <% else %>
    <ul class="space-y-3 overflow-y-auto">
      <% @comments.each do |comment| %>
        <%= render "users/comment", comment: comment %>
      <% end %>
    </ul>
  <% end %>
<% end %>
