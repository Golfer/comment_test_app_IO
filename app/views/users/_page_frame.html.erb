<%= turbo_frame_tag frame_id do %>
  <% users.each do |user| %>
    <%= render "users/user", user: user, current: user == current_user %>
  <% end %>
  <% if next_page %>
    <%= turbo_frame_tag "users_page_#{next_page}",
          loading: :lazy,
          src: users_path(page: next_page) %>
  <% end %>
<% end %>
