<%# locals: comment %>
<li id="<%= dom_id(comment, :profile) %>">
  <%= link_to comment.deep_link_path,
        class: "group block rounded-xl bg-white p-4 shadow-sm ring-1 ring-gray-200 transition hover:ring-indigo-200 hover:bg-indigo-50/40" do %>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide <%= comment.root? ? "bg-indigo-50 text-indigo-700 ring-1 ring-indigo-200" : "bg-gray-100 text-gray-600 ring-1 ring-gray-200" %>">
        <%= comment.root? ? t("views.users.comment.post_kind") : t("views.users.comment.reply_kind") %>
      </span>
      <time datetime="<%= comment.created_at.iso8601 %>" class="text-xs text-gray-500">
        <%= t("views.shared.time_ago", time: time_ago_in_words(comment.created_at)) %>
      </time>
    </div>

    <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-gray-700 line-clamp-4"><%= comment_body(comment) %></p>

    <%= render "shared/cta_arrow", text: t("views.users.comment.open_in_thread"), class: "mt-3" %>
  <% end %>
</li>
